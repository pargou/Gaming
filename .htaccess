Options -Indexes

# Toujours en https (le certificat Let's Encrypt est actif chez OVH)
RewriteEngine On
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Fichiers internes du bot : pas besoin de les servir
RedirectMatch 404 ^/(scripts|_bot|\.github)(/|$)
RedirectMatch 404 ^/README\.md$
